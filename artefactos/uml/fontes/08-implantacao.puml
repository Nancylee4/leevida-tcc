@startuml
!include skin.iuml
skinparam nodesep 40
skinparam ranksep 60

node "Estação de trabalho da clínica" <<device>> as WS {
  node "Navegador web" <<executionEnvironment>> as BR1 {
    artifact "leevida-front-end\n(build estático)" as FE1
  }
}

node "Smartphone / computador do paciente" <<device>> as PD {
  node "Navegador web" <<executionEnvironment>> as BR2 {
    artifact "leevida-front-end\n(portal do paciente)" as FE2
  }
}

node "Servidor virtual (VPS) — configuração recomendada" <<device>> as SRV {
  node "Firewall\n(só portas 443 e 22 abertas)" <<executionEnvironment>> as FW
  node "Nginx — proxy reverso\n(TLS, certificado Let's Encrypt)" <<executionEnvironment>> as PX {
    artifact "leevida-front-end/dist" as FEDIST
  }
  node "Node.js 22" <<executionEnvironment>> as NODE {
    artifact "leevida-backend\n(API NestJS)" as BE
  }
  node "PostgreSQL 16\n(só em localhost)" <<executionEnvironment>> as PGN {
    artifact "leevida_db" as DBA
  }
}

node "Google Cloud" <<device>> as GCP {
  node "Gemini API" <<executionEnvironment>> as GEM
}

WS -- FW : <<HTTPS 443>>\nInternet
PD -- FW : <<HTTPS 443>>\nInternet
FW -- PX
PX -- NODE : <<HTTP localhost:3000>>
NODE -- PGN : <<TCP localhost:5432>>
NODE -- GEM : <<HTTPS>>\nsó dados pseudonimizados
note bottom of SRV
  Todo o tráfego externo entra pela porta 443 do Nginx;
  a API e a base de dados não ficam expostas à Internet.
  A clínica não abre portas na sua rede local.
end note
@enduml
