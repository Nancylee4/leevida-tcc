@startuml
!include skin.iuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 60

actor "//Utilizador//" as U
actor "Administrador" as A
actor "Enfermeiro" as E
actor "Médico" as M
actor "Paciente" as P
actor "Serviço de IA\n(Google Gemini)" as G <<sistema>>

U <|-- A
U <|-- E
U <|-- M
U <|-- P

rectangle "Sistema LeeVida" {
  usecase "UC01 Autenticar-se" as UC01
  usecase "UC02 Gerir perfil" as UC02
  usecase "UC03 Consultar notificações" as UC03

  usecase "UC04 Gerir utilizadores" as UC04
  usecase "UC05 Consultar logs\nde auditoria" as UC05

  usecase "UC06 Registar paciente" as UC06
  usecase "UC07 Emitir credenciais\ndo paciente" as UC07
  usecase "UC08 Registar triagem" as UC08
  usecase "UC09 Sugerir prioridade\nde triagem (IA)" as UC09

  usecase "UC10 Gerir agenda" as UC10
  usecase "UC11 Aceitar ou rejeitar\nconsulta" as UC11
  usecase "UC12 Consultar\nprontuário" as UC12
  usecase "UC13 Gerar resumo\npré-consulta (IA)" as UC13
  usecase "UC14 Realizar consulta" as UC14
  usecase "UC15 Sugerir códigos\nCID-10 (IA)" as UC15
  usecase "UC16 Registar consulta\nde retorno" as UC16
  usecase "UC17 Emitir prescrição" as UC17
  usecase "UC18 Assinar prescrição" as UC18
  usecase "UC19 Verificar segurança\nda receita" as UC19
  usecase "UC20 Utilizar assistente\nde prescrição (IA)" as UC20
  usecase "UC21 Solicitar exame" as UC21
  usecase "UC22 Registar resultado\nde exame" as UC22
  usecase "UC23 Interpretar\nresultado (IA)" as UC23
  usecase "UC24 Emitir justificativo\nmédico" as UC24

  usecase "UC25 Marcar consulta" as UC25
  usecase "UC26 Consultar histórico,\nreceitas e exames próprios" as UC26
}

U -- UC01
U -- UC02
U -- UC03

A -- UC04
A -- UC05

E -- UC06
E -- UC08

M -- UC10
M -- UC11
M -- UC12
M -- UC14
M -- UC16
M -- UC17
M -- UC18
M -- UC20
M -- UC21
M -- UC22
M -- UC24

P -- UC25
P -- UC26

UC06 ..> UC07 : <<include>>
UC08 <.. UC09 : <<extend>>
UC12 <.. UC13 : <<extend>>
UC14 <.. UC15 : <<extend>>
UC18 ..> UC19 : <<include>>
UC22 <.. UC23 : <<extend>>

UC09 -- G
UC13 -- G
UC15 -- G
UC19 -- G
UC20 -- G
UC23 -- G
@enduml
